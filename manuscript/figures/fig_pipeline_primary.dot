digraph P {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=10, nodesep=0.18, ranksep=0.28, margin=0.04];
  node  [shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#5B6575", fontname="DejaVu Sans", fontsize=8.5];
  edge  [color="#5B6575", arrowsize=0.55];
  in   [label="Input\npatient's blood smear\nsingle-cell images\n(up to 500 cells)", fillcolor="#DCE6F5"];
  qc   [label="Quality control\nunreadable files\n-> missing, imputed"];
  shift[label="Shift test (label-free)\ncan cells be assigned\nto their cohort?", fillcolor="#FCEBD0", shape=diamond, style="filled"];
  mac  [label="Macenko stain\nnormalization\n(per cell)\n0.071 s / cell", fillcolor="#E4F1E4"];
  subgraph cluster_a { label="Engineered branch (original images)"; fontsize=8; style=dashed; color="#9AA4B2";
    seg  [label="Nucleus segmentation\n+ cytoplasm proxies"];
    eng  [label="93 morphology\nfeatures per cell"];
    pool [label="Pooled statistics\n-> logistic regression"];
    mil  [label="Attention MIL\n(40 epochs)"];
  }
  subgraph cluster_b { label="Deep branch"; fontsize=8; style=dashed; color="#9AA4B2";
    ft   [label="Fine-tuned\nEfficientNet-B0\n(last 2 stages + head)", fillcolor="#E4F1E4"];
    pc   [label="Probability of APL\nper cell"];
    mp   [label="Mean over\nthe patient's cells"];
  }
  ens  [label="Ensemble\nmean of percentile scores\n(pre-specified)", fillcolor="#E4F1E4"];
  thr  [label="Threshold set on development\ndata for recall >= 0.95", fillcolor="#FCEBD0"];
  out  [label="Output\nAPL suspected / not\n+ score", fillcolor="#DCE6F5"];
  in -> qc -> shift;
  shift -> mac [label=" yes", fontsize=7.5];
  shift -> ft [label=" no", fontsize=7.5, style=dashed];
  mac -> ft -> pc -> mp -> ens;
  qc -> seg -> eng; eng -> pool -> ens; eng -> mil -> ens;
  ens -> thr -> out;
}

digraph P {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.18, ranksep=0.2, margin=0.02, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#5B6575", fontname="DejaVu Sans", fontsize=13, margin="0.08,0.04"];
  edge  [color="#5B6575", arrowsize=0.7];
  subgraph cluster_p { label="(a) Primary pipeline (about 80 s per patient)"; fontsize=14; style="rounded"; color="#9AA4B2";
    in   [label="Cells of one patient (up to 500)", fillcolor="#DCE6F5"];
    mac  [label="Macenko (if shift)", fillcolor="#E4F1E4"];
    ft   [label="Fine-tuned\nEfficientNet-B0", fillcolor="#E4F1E4"];
    mp   [label="Mean cell\nprobability"];
    seg  [label="93 engineered features\n(original images)"];
    pool [label="Pooled LR"];
    mil  [label="Attention MIL"];
    ens  [label="Mean of percentile scores", fillcolor="#E4F1E4"];
    thr  [label="Development threshold", fillcolor="#FCEBD0"];
    out  [label="Prioritize for review", fillcolor="#DCE6F5"];
    in -> mac -> ft -> mp -> ens; in -> seg; seg -> pool -> ens; seg -> mil -> ens; ens -> thr -> out;
  }
  subgraph cluster_s { label="(b) Secondary pipeline (about 61 s per patient)"; fontsize=14; style="rounded"; color="#9AA4B2";
    in2  [label="Cells of one patient", fillcolor="#DCE6F5"];
    mac2 [label="Macenko (if shift)", fillcolor="#E4F1E4"];
    cnn2 [label="Frozen EfficientNet-B0"];
    pca2 [label="PCA-64 (20x smaller)", fillcolor="#E4F1E4"];
    lr2  [label="Pooled LR (321 parameters)"];
    thr2 [label="Development threshold", fillcolor="#FCEBD0"];
    out2 [label="Prioritize for review", fillcolor="#DCE6F5"];
    in2 -> mac2 -> cnn2 -> pca2 -> lr2 -> thr2 -> out2;
  }
}

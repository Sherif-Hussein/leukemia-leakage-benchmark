digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.2, ranksep=0.22, margin=0.03];
  node  [shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#5B6575", fontname="DejaVu Sans", fontsize=13, margin="0.08,0.04"];
  edge  [color="#5B6575", arrowsize=0.7];
  raw  [label="Single-cell images\nAPL-AML | C-NMC | MLL", fillcolor="#DCE6F5"];
  man  [label="Manifest + quality control\n(unreadable = missing)"];
  split[label="External sets fixed first\n(never used for fitting)", fillcolor="#FCEBD0"];
  shift[label="Label-free shift test", fillcolor="#FCEBD0"];
  subgraph cluster_a { label="Engineered"; fontsize=13; color="#9AA4B2"; style=dashed;
    seg [label="Nucleus + cytoplasm\nsegmentation"];
    fe  [label="93 features"];
  }
  subgraph cluster_b { label="Deep"; fontsize=13; color="#9AA4B2"; style=dashed;
    mac [label="Macenko\n(if shift)"];
    cnn [label="EfficientNet-B0\nor DinoBloom-S"];
  }
  fold [label="Inside training folds only:\nimputation, scaling, PCA,\nthreshold (recall >= 0.95)", fillcolor="#FCEBD0"];
  raw -> man -> split -> shift;
  split -> seg -> fe -> fold;
  shift -> mac -> cnn -> fold;
}
